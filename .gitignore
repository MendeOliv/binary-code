# Dependencies
node_modules/
.pnp/

# Environment (never commit secrets)
.env
.env.local
.env.*.local

# Build outputs
dist/
.next/
out/
.turbo/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# TypeScript build info
*.tsbuildinfo

# Compiled JS in source directories (should be generated by build)
packages/shared/src/*.js
packages/shared/src/*.d.ts
packages/shared/src/*.d.ts.map
packages/shared/src/*.js.map

# Temp files
*.tmp
*.bak

# IDE
.vscode/
.idea/
.env.backup
