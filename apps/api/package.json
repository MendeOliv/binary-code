{
  "name": "@binary-code/api",
  "version": "1.0.0",
  "private": true,
  "description": "Código Binário API (codename Hermes)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@anthropic-ai/sdk --external:openai --external:@google/generative-ai --external:groq-sdk --external:@supabase/supabase-js --external:fastify --external:@fastify/cors --external:zod --external:dotenv",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@fastify/cors": "^11.3.0",
    "@google/generative-ai": "^0.24.0",
    "@supabase/supabase-js": "^2.112.4",
    "fastify": "^5.12.1",
    "groq-sdk": "^0.9.0",
    "openai": "^4.0.0",
    "shared": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.4.5"
  }
}
