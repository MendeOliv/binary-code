# ── Código Binário API (Hermes) — environment template ──
# Copy to `.env` and fill real values. NEVER commit secrets.

# ── Supabase (required) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI Providers ──
# Gemini is PRIMARY. The rest are fallbacks in this order:
#   Gemini → Groq → NVIDIA Nemotron-70B → Anthropic → OpenAI
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Provider routing (defaults are correct for the spec chain).
PRIMARY_PROVIDER=gemini
FALLBACK_PROVIDER=groq

# Optional per-provider model overrides.
#GEMINI_MODEL=gemini-2.0-flash
#GROQ_MODEL=groq/compound-mini
#NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
#ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
#OPENAI_MODEL=gpt-4o-mini

# Timeout (ms) applied to provider HTTP calls.
#AI_TIMEOUT_MS=60000

# ── Admin / Security ──
# Secret for internal/administrative routes under /api/projects and admin GETs.
# Disabled (503) when unset — fail closed.
HERMES_API_KEY=
ADMIN_API_KEY=

# ── CORS ──
#ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Rate limiting (public endpoints) ──
#RATE_LIMIT_WINDOW_SECONDS=60
#RATE_LIMIT_MAX_REQUESTS=20
#RATE_LIMIT_DISABLED=0

# Trust X-Forwarded-For (set to true on Render/behind a proxy) for accurate
# per-IP rate limiting.
#APP_TRUST_PROXY=true

# ── Notifications (email via Resend) ──
# Default transport is a no-op console logger. Enable email with:
NOTIFICATION_PROVIDER=console
#RESEND_API_KEY=
#NOTIFICATION_EMAIL_FROM="Código Binário <diagnostics@yourdomain>"
# Recipient defaults to fabiobessadeoliveira2@gmail.com when unset.
#NOTIFICATION_EMAIL_TO=fabiobessadeoliveira2@gmail.com

# ── Server ──
PORT=3001
NODE_ENV=development