{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "baseUrl": "../..",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "paths": {
      "@db/*": ["packages/db/src/*"],
      "@shared/*": ["packages/shared/src/*"],
      "@core/*": ["packages/core/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "../packages/db/src/**/*",
    "../packages/shared/src/**/*",
    "../packages/core/src/**/*"
  ]
}
